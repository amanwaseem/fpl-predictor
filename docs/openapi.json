          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Get Gameweek",
        "tags": [
          "gameweeks"
        ]
      }
    },
    "/v1/gameweeks/{gameweek}/predictions": {
      "get": {
        "description": "One committed entry's predictions, highest first, with actual points once scored.",
        "operationId": "list_predictions_v1_gameweeks__gameweek__predictions_get",
        "parameters": [
          {
            "in": "path",
            "name": "gameweek",
            "required": true,
            "schema": {
              "examples": [
                6
              ],
              "maximum": 38,
              "minimum": 1,
              "title": "Gameweek",
              "type": "integer"
            }
          },
          {
            "description": "A model_version.",
            "in": "query",
            "name": "model",
            "required": true,
            "schema": {
              "description": "A model_version.",
              "examples": [
                "baseline-v1",
                "form-fixture-v1"
              ],
              "pattern": "^[A-Za-z0-9.-]{1,40}$",
              "title": "Model",
              "type": "string"
            }
          },
          {
            "description": "Defaults to the latest season.",
            "in": "query",
            "name": "season",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{4}/\\d{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Defaults to the latest season.",
              "examples": [
                "2026/27"
              ],
              "title": "Season"
            }
          },
          {
            "in": "query",
            "name": "position",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "GKP",
                    "DEF",
                    "MID",
                    "FWD"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Position"
            }
          },
          {
            "in": "query",
            "name": "team",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[A-Z]{3}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                "ARS"
              ],
              "title": "Team"
            }
          },
          {
            "description": "\u00a3m",
            "in": "query",
            "name": "max_price",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 20,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "\u00a3m",
              "title": "Max Price"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "next_cursor from the previous page: its last row's predicted_points:player_id",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^-?\\d{1,20}(\\.\\d{1,30})?:\\d{1,9}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "next_cursor from the previous page: its last row's predicted_points:player_id",
              "examples": [
                "6.94:124"
              ],
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "List Predictions",
        "tags": [
          "gameweeks"
        ]
      }
    },
