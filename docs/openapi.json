  "info": {
    "description": "Committed FPL predictions, their scores, and the data behind them. Read-only. Errors are RFC 9457 problem details.",
    "title": "fpl-predictor",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "The process is up. Says nothing about the database.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "The database answers and its schema is at the latest migration.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/gameweeks": {
      "get": {
        "description": "Every gameweek of the season, with the models that logged an entry for it.",
        "operationId": "list_gameweeks_v1_gameweeks_get",
        "parameters": [
          {
            "description": "Defaults to the latest season.",
            "in": "query",
            "name": "season",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{4}/\\d{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Defaults to the latest season.",
              "examples": [
                "2026/27"
              ],
              "title": "Season"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameweekList"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "List Gameweeks",
        "tags": [
          "gameweeks"
        ]
      }
    },
    "/v1/gameweeks/{gameweek}": {
      "get": {
        "description": "One gameweek: its fixtures, and each model's entry with its score once settled.",
        "operationId": "get_gameweek_v1_gameweeks__gameweek__get",
        "parameters": [
          {
            "in": "path",
            "name": "gameweek",
            "required": true,
            "schema": {
              "examples": [
                6
              ],
              "maximum": 38,
              "minimum": 1,
              "title": "Gameweek",
              "type": "integer"
            }
          },
          {
            "description": "Defaults to the latest season.",
            "in": "query",
            "name": "season",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{4}/\\d{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Defaults to the latest season.",
              "examples": [
                "2026/27"
              ],
              "title": "Season"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameweekDetail"
                }
              }
            },
            "description": "Successful Response"
          },
