# Python
__pycache__/
*.py[codz]
build/
dist/
*.egg-info/

# Environment
.venv/
.env

# Tooling: coverage, lint, test caches
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.pytest_cache/
.hypothesis/

# Raw API snapshots — large, regenerable via fpl/ingest/fetch.py (hard rule 3)
data/raw/

# Exploratory runs — throwaway, never a real prediction
scratch/

# Partial log entries — write_entry cleans these up, but a hard kill
# could leave one, and a truncated entry must never be committed.
predictions/*.tmp

# schemathesis's run cache, from make fuzz
.schemathesis/
