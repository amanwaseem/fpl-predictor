# Python
__pycache__/
*.py[codz]
build/
dist/
*.egg-info/

# Environment, and anything that may hold a credential such as DATABASE_URL
.venv/
venv/
env/
.env
.envrc

# Tooling: coverage, lint, test caches
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.pytest_cache/
.hypothesis/
.mypy_cache/
*.log

# Raw API snapshots — large, regenerable via fpl/ingest/fetch.py (hard rule 3)
data/raw/

# Trained models fetched from their release, by SHA-256 (#85); the registry is
# committed, the artifacts are not
data/models/

# Exploratory runs — throwaway, never a real prediction
scratch/

# Partial log entries — write_entry cleans these up, but a hard kill
# could leave one, and a truncated entry must never be committed.
predictions/*.tmp
predictions-*/*.tmp

# schemathesis's run cache, from make fuzz
.schemathesis/
