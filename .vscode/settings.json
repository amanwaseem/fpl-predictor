{
  // Hide generated and cached folders from the explorer and from search.
  // They are all gitignored; this only keeps the sidebar to what is real.
  "files.exclude": {
    ".venv": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.hypothesis": true,
    "**/.schemathesis": true,
    "**/*.egg-info": true,
    "**/.DS_Store": true,
    ".coverage*": true,
    "htmlcov": true,
    "build": true,
    "dist": true,
    "web/dist": true,
    "web/test-results": true,
    "web/playwright-report": true
  },
  "search.exclude": {
    ".venv": true,
    "web/node_modules": true,
    "data": true,
    "scratch": true,
    "uv.lock": true,
    "web/package-lock.json": true,
    "docs/openapi.json": true
  },
  // Companion files fold under the file they belong to, so the root reads as
  // a handful of entries. Click the arrow beside a file to see what it holds.
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "pyproject.toml": "uv.lock, .pre-commit-config.yaml, Makefile",
    "README.md": "LICENSE",
    "Dockerfile": ".dockerignore, docker-compose.yml, fly.toml",
    ".gitignore": ".gitattributes"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "[python]": {
    "editor.rulers": [100]
  }
}
